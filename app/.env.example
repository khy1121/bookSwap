NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# seed 스크립트 전용. 절대 클라이언트/커밋에 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 교재 표지 조회 (scripts/fetch-covers.ts). developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
KAKAO_REST_API_KEY=
# 푸터 피드백 링크(없으면 코드 기본값 사용)
NEXT_PUBLIC_FEEDBACK_URL=https://open.kakao.com/o/sfnqXPKi
NEXT_PUBLIC_GOOGLE_LOGIN=on

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@hansung.ac.kr
# Supabase Database Webhook → /api/push/chat 인증용 임의 문자열
PUSH_WEBHOOK_SECRET=
